{
  "name": "opencode-tui-context",
  "version": "2.1.1",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode TUI plugin that renders session context-window usage as a segmented bar in the sidebar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolitudeRA/opencode-tui-context.git"
  },
  "homepage": "https://github.com/SolitudeRA/opencode-tui-context#readme",
  "bugs": {
    "url": "https://github.com/SolitudeRA/opencode-tui-context/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "context-window",
    "tokens"
  ],
  "author": "SolitudeRA",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "tui.js",
    "docs/assets/context-preview.svg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "opencode": ">=1.18.31 <2 || >=2.0.32 <3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:render": "npm run build && node scripts/test-entrypoints.mjs && bun --conditions=browser scripts/test-render.mjs && bun --conditions=browser --preload ./scripts/test-v1-runtime.mjs scripts/test-render-v1.mjs",
    "release:pack": "node scripts/release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && bun test && npm run test:render"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "babel-preset-solid": "1.9.12",
    "@opencode/plugin": "2.0.32",
    "@opencode/theme": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/core-v1": "npm:@opentui/core@0.4.5",
    "@opentui/solid": "0.5.17",
    "@opentui/solid-v1": "npm:@opentui/solid@0.4.5",
    "@types/bun": "^1.4.2",
    "@types/node": "24.12.2",
    "esbuild": "^0.25.0",
    "fflate": "0.8.3",
    "solid-js": "1.9.15",
    "solid-js-v1": "npm:solid-js@1.9.12",
    "typescript": "5.8.2"
  }
}
